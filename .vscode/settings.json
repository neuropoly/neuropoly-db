{
  // Python interpreter — use the project venv
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Jupyter
  "jupyter.notebookFileRoot": "${workspaceFolder}",

  // Editor — formatting on save (global + notebooks)
  "editor.formatOnSave": true,
  "notebook.formatOnSave.enabled": true,

  // Python-specific editor behaviour
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      // Sort imports with isort on every save
      "source.organizeImports": "explicit"
    }
  },

  // Use locked project tools; shared style settings live in pyproject.toml.
  "black-formatter.path": ["${workspaceFolder}/.venv/bin/black"],
  "black-formatter.cwd": "${workspaceFolder}",
  "isort.path": ["${workspaceFolder}/.venv/bin/isort"],
  "isort.cwd": "${workspaceFolder}",

  // Pylance type-checking acts as the in-editor linter
  "python.analysis.typeCheckingMode": "standard",

  // Terminal
  "terminal.integrated.defaultProfile.linux": "bash",
  "jupyter.kernels.excludePythonEnvironments": [
    "${workspaceFolder}/.venv/bin/python"
  ]
}
